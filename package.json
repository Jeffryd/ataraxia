{
  "name": "ataraxia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @ataraxia/api\" \"npm run dev -w @ataraxia/web\"",
    "build": "npm run build -w @ataraxia/shared && npm run build -w @ataraxia/api && npm run build -w @ataraxia/web",
    "start": "npm run start -w @ataraxia/api",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p apps/api && tsc --noEmit -p apps/web",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "typescript-eslint": "^8.71.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "jsdom": "^30.1.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "concurrently": "^10.0.5"
  }
}
